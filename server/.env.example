# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=*

# ── Deployment mode ─────────────────────────────────────────────────────────────
# Set LOADS_SOURCE_URL to switch to Pi mode.
#
#   Pi mode   (LOADS_SOURCE_URL set)   — serves webapp, handles SD cards,
#                                        syncs loads from TrueNAS, uploads to Nextcloud
#   TrueNAS mode (LOADS_SOURCE_URL absent) — runs Burble scraper 24/7, no SD handling
#
# Pi example:
# LOADS_SOURCE_URL=http://truenas.local:3001

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=/data/skybox.db

# ── NVMe / local storage (Pi only) ────────────────────────────────────────────
# Root directory where SD card footage is copied to
# Files land at: $MEDIA_ROOT/inbox/YYYY-MM-DD/filename.MP4
MEDIA_ROOT=/mnt/nvme/skybox

# ── Nextcloud (Pi only) ────────────────────────────────────────────────────────
# Your Nextcloud instance URL (no trailing slash)
NEXTCLOUD_URL=https://nextcloud.yourdomain.com
# WebDAV credentials (use an app password, not your main password)
NEXTCLOUD_USER=your_username
NEXTCLOUD_PASSWORD=your_app_password

# ── Burble DZ (TrueNAS only) ──────────────────────────────────────────────────
DZ_ID=2351
DZ_TZ=Europe/Madrid
DZ_LAT=37.16
DZ_LON=-5.61
